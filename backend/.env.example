# ============================================================================
# Payment Guardian - Backend Environment Template
# Copy to backend/.env and fill in real values. Never commit backend/.env
# ============================================================================

# --- Supabase Project ---
SUPABASE_PROJECT_ID=your_project_ref
SUPABASE_URL=https://your_project_ref.supabase.co

# --- Supabase API Keys (Dashboard > Project Settings > API) ---
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# --- Database ---
# Supabase pooler, Session Mode (port 5432) works best with SQLAlchemy.
# URL-encode special characters in the password (e.g. @ becomes %40).
# Local fallback: sqlite:///./guardian.db
DATABASE_URL=postgresql://postgres.your_project_ref:your_password@aws-0-your-region.pooler.supabase.com:5432/postgres

# --- Google Gemini API Configuration ---
# Get a free key at: https://aistudio.google.com/
LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-flash-lite-latest

# --- Server Configuration ---
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
JWT_SECRET=change_me_in_production
